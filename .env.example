# Aave Flash Loan Contract - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# RPC Provider (Choose one)
# ============================================
# Get free API key from https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# OR use Infura: https://infura.io/
# INFURA_API_KEY=your_infura_api_key_here

# ============================================
# Deployment Wallet
# ============================================
# Private key of the wallet that will deploy the contract
# NEVER commit this file with real keys to git!
# IMPORTANT: Remove 0x prefix if your key has it
PRIVATE_KEY=your_private_key_without_0x_prefix

# ============================================
# Contract Verification
# ============================================
# Get from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# Optional: Gas Reporting
# ============================================
# Set to "true" to enable gas reporting in tests
REPORT_GAS=false

# Get from https://coinmarketcap.com/api/ for USD price conversion
# COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
